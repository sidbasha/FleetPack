{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ng serve",
      "type": "shell",
      "command": "npm",
      "args": [
        "exec",
        "ng",
        "serve",
        "--",
        "--host",
        "localhost",
        "--port",
        "4200"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Building.*",
          "endsPattern": ".*Local:.*http://localhost:4200/.*"
        }
      }
    }
  ]
}
