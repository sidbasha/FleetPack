{
  "name": "fleetpack-fam",
  "version": "3.0.0",
  "description": "KLA FleetPack — Fleet Availability Module (FAM). Nexus Theme v2. Angular 20 + Tailwind 4 + Signals state + Mock API.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "storybook": "ng run fleetpack-fam:storybook",
    "build-storybook": "ng run fleetpack-fam:build-storybook",
    "build:base": "ng build fleetpack-base && node scripts/build-base-styles.mjs",
    "build:base:dev": "ng build fleetpack-base --configuration development && node scripts/build-base-styles.mjs",
    "pack:base": "npm pack ./dist/fleetpack-base --pack-destination ./dist",
    "verify:base": "node scripts/verify-lib-install.mjs && node scripts/verify-lib-functional.mjs",
    "publish:base": "npm publish ./dist/fleetpack-base"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "chart.js": "^4.5.0",
    "ng2-charts": "^6.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "storybook": "^10.5.4",
    "@storybook/angular": "^10.5.4",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@types/node": "^20",
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-devkit/architect": "^0.2000.0",
    "@angular-devkit/core": "^20.0.0",
    "@angular/animations": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@compodoc/compodoc": "^2.0.0",
    "ng-packagr": "^20.0.0"
  }
}
